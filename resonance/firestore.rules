rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A profile is private unless the owner explicitly publishes its derived summary.
    match /users/{uid}/records/{recordId} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.role in ['센티넬', '가이드']
        && request.resource.data.axes is list && request.resource.data.axes.size() == 6
        && request.resource.data.facets is list && request.resource.data.facets.size() == 12
        && request.resource.data.choices is list && request.resource.data.choices.size() == 8
        && request.resource.data.answers is list && request.resource.data.answers.size() == 40;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /publicProfiles/{profileId} {
      allow get, list: if resource.data.isPublic == true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isPublic == true
        && request.resource.data.keys().hasOnly(['id','name','role','axes','facets','choices','isPublic','version','updatedAt','ownerUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.role in ['센티넬','가이드']
        && request.resource.data.axes is list && request.resource.data.axes.size() == 6
        && request.resource.data.facets is list && request.resource.data.facets.size() == 12
        && request.resource.data.choices is list && request.resource.data.choices.size() == 8;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.isPublic == true
        && request.resource.data.keys().hasOnly(['id','name','role','axes','facets','choices','isPublic','version','updatedAt','ownerUid']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
